{
  "name": "electron-app",
  "productName": "Gadgets POS",
  "version": "2.0.0",
  "description": "POS application for Gadgets POS",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "release:check": "node --test tests/release/release.check.js",
    "predist": "npm run release:check",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.gadgetspos",
    "productName": "Gadgets POS",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "labels/**",
      "assets/**",
      "scripts/**",
      "!scripts/after-pack-fuses.js",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**"
    ],
    "afterPack": "./scripts/after-pack-fuses.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://CHANGE-ME.example.com/gadgetspos-desktop/"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false
    },
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.11"
  },
  "author": "DoneSol Technologies",
  "license": "ISC",
  "keywords": [
    "electron",
    "gadgets",
    "POS"
  ]
}
