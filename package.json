{
  "name": "electron-app",
  "productName": "Gadgets POS",
  "version": "2.0.1",
  "description": "POS application for Gadgets POS",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "release:check": "node --test tests/release/release.check.js",
    "predist": "npm run release:check",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.gadgetspos",
    "productName": "Gadgets POS",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "labels/**",
      "assets/**",
      "scripts/**",
      "!scripts/after-pack-fuses.js",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**"
    ],
    "afterPack": "./scripts/after-pack-fuses.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://gadgetspos.com/app-releases/desktop/"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Gadgets-POS-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Gadgets-POS-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.29.14",
    "@electron/fuses": "^1.8.0",
    "electron": "^45.4.1",
    "electron-builder": "^24.13.3",
    "pdfkit": "^0.15.2",
    "puppeteer-core": "^23.11.1",
    "sax": "^1.6.1"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.11"
  },
  "author": "DoneSol Technologies",
  "license": "ISC",
  "keywords": [
    "electron",
    "gadgets",
    "POS"
  ]
}
